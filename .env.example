# NoGhost — copy to .env.local at this level and fill in.
# Never commit real values; add them in the Vercel dashboard.
#
# ONE file for the whole monorepo. Both apps read it via `loadRootEnv()` in
# env.config.ts, called from each next.config.ts, and every script under
# packages/db reads it via `loadRepoEnv()`. There is deliberately no
# apps/web/.env.local or apps/admin/.env.local — two copies of the same secret
# are two things that can drift, and the way that fails is an app pointed at one
# Supabase project while its sibling reads another, with both looking fine.

# ---- Seed mode -------------------------------------------------------------
# true  → the app reads local seed fixtures; no service is needed.
# false → the app reads the dedicated Supabase project below.
NEXT_PUBLIC_USE_SEED_DATA=true

# NOTE: every server-only variable below must ALSO be listed in `turbo.json`'s
# `globalEnv`. Turborepo hashes and filters task environments, and a variable it
# does not know about is stripped before the build sees it — `NEXT_PUBLIC_*`
# survive via framework inference, secrets do not. A missing entry there looks
# exactly like a variable nobody set: the Vercel build failed with
# "SUPABASE_SECRET_KEY is not set" while the dashboard showed it present.

# ---- Supabase (the NEW dedicated project — locked decision #17) ------------
# New-style keys. `anon` / `service_role` are legacy and must not be used.
#
# The URL is the bare origin — no /rest/v1, no trailing slash. supabase-js
# appends /rest/v1, /auth/v1 and /storage/v1 itself, and a path here produces
# /rest/v1/rest/v1/... where EVERY request fails with PGRST125. That failure
# looks exactly like a working RLS policy from the client side, so `pnpm
# db:verify` rejects a URL with a path outright rather than reporting green.
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxx
SUPABASE_SECRET_KEY=sb_secret_xxxx          # SERVER ONLY — bypasses RLS

# ---- URLs ------------------------------------------------------------------
NEXT_PUBLIC_MARKETING_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Stripe (Phase 2) ------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_xxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxx
STRIPE_PRICE_EARLY_BIRD=price_xxxx
STRIPE_PRICE_STANDARD=price_xxxx

# ---- Email & SMS (Phase 2) -------------------------------------------------
RESEND_API_KEY=re_xxxx
TWILIO_ACCOUNT_SID=ACxxxx
TWILIO_AUTH_TOKEN=xxxx
TWILIO_MESSAGING_SERVICE_SID=MGxxxx

# ---- Tone check on closure personal lines (Phase 4) ------------------------
ANTHROPIC_API_KEY=sk-ant-xxxx

# ---- Cron (Phase 3+) -------------------------------------------------------
# Every endpoint in spec §4.3 verifies this. Minimum 16 characters.
CRON_SECRET=change-me-to-a-long-random-string

# ---- Admin app -------------------------------------------------------------
# Nothing reads this. §7.3 describes an ADMIN_EMAILS allow-list, but every
# is_admin() check is SQL evaluated inside Postgres, and Postgres cannot read
# the app's environment — so the `admin_users` table is the allow-list. Grant
# somebody access with:
#
#   pnpm admin:grant you@example.com
#
# Left here, unset and labelled, because the spec names it: an unexplained
# absence sends the next person looking for where it went.

# ---- Web Push (Phase 5) ----------------------------------------------------
# Self-generated — Web Push needs no account and costs nothing. Make a pair with:
#
#   pnpm vapid:keys
#
# The public key is shipped to the browser and is safe there; the private key
# signs the push and is server-only. The subject must be a mailto: or https:
# URL the push services can use to contact you about your sending.
#
# Rotating these invalidates every existing subscription — browsers key their
# subscription to the public key, so every member has to re-enable notifications.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ---- Preview (local only) --------------------------------------------------
# Turns on /auth/confirm, which redeems an admin-issued link into a session so
# the member app can be looked at before Twilio exists:
#
#   pnpm db:seed:remote --chats   # build a season with members and chats
#   pnpm preview:member            # prints a one-time sign-in URL
#
# Never set this in production. §7.4 gives this product one credential — a
# phone OTP — and a debugging convenience should not quietly become a second
# way in. Without it the route 404s and the script refuses to mint anything.
PREVIEW_SIGN_IN=off
