# NoGhost — copy to apps/web/.env.local and fill in.
# Never commit real values; add them in the Vercel dashboard.

# ---- Seed mode -------------------------------------------------------------
# true  → the app reads local seed fixtures; no service is needed.
# false → the app reads the dedicated Supabase project below.
NEXT_PUBLIC_USE_SEED_DATA=true

# ---- Supabase (the NEW dedicated project — locked decision #17) ------------
# New-style keys. `anon` / `service_role` are legacy and must not be used.
#
# The URL is the bare origin — no /rest/v1, no trailing slash. supabase-js
# appends /rest/v1, /auth/v1 and /storage/v1 itself, and a path here produces
# /rest/v1/rest/v1/... where EVERY request fails with PGRST125. That failure
# looks exactly like a working RLS policy from the client side, so `pnpm
# db:verify` rejects a URL with a path outright rather than reporting green.
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxx
SUPABASE_SECRET_KEY=sb_secret_xxxx          # SERVER ONLY — bypasses RLS

# ---- URLs ------------------------------------------------------------------
NEXT_PUBLIC_MARKETING_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Stripe (Phase 2) ------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_xxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxx
STRIPE_PRICE_EARLY_BIRD=price_xxxx
STRIPE_PRICE_STANDARD=price_xxxx

# ---- Email & SMS (Phase 2) -------------------------------------------------
RESEND_API_KEY=re_xxxx
TWILIO_ACCOUNT_SID=ACxxxx
TWILIO_AUTH_TOKEN=xxxx
TWILIO_MESSAGING_SERVICE_SID=MGxxxx

# ---- Tone check on closure personal lines (Phase 4) ------------------------
ANTHROPIC_API_KEY=sk-ant-xxxx

# ---- Cron (Phase 3+) -------------------------------------------------------
# Every endpoint in spec §4.3 verifies this. Minimum 16 characters.
CRON_SECRET=change-me-to-a-long-random-string

# ---- Admin app -------------------------------------------------------------
ADMIN_EMAILS=you@example.com

# ---- Web Push (Phase 5) ----------------------------------------------------
# Self-generated — Web Push needs no account and costs nothing. Make a pair with:
#
#   pnpm vapid:keys
#
# The public key is shipped to the browser and is safe there; the private key
# signs the push and is server-only. The subject must be a mailto: or https:
# URL the push services can use to contact you about your sending.
#
# Rotating these invalidates every existing subscription — browsers key their
# subscription to the public key, so every member has to re-enable notifications.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
