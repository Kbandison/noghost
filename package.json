{
  "name": "noghost",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "db:seed": "pnpm --filter @noghost/db run seed",
    "db:verify": "tsx packages/db/scripts/verify-schema.ts",
    "db:seed:remote": "tsx packages/db/scripts/seed-remote.ts",
    "db:verify:writes": "tsx packages/db/scripts/verify-writes.ts",
    "admin:grant": "tsx packages/db/scripts/grant-admin.ts"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "tsx": "^4.23.1",
    "turbo": "^2.6.2",
    "typescript": "^5.9.3"
  }
}
