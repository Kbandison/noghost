{
  "name": "noghost",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "db:seed": "pnpm --filter @noghost/db run seed",
    "db:verify": "tsx packages/db/scripts/verify-schema.ts",
    "aws:check": "tsx packages/db/scripts/check-aws.ts",
    "db:seed:remote": "tsx packages/db/scripts/seed-remote.ts",
    "preview:member": "tsx packages/db/scripts/preview-member.ts",
    "db:verify:writes": "tsx packages/db/scripts/verify-writes.ts",
    "db:verify:fuse": "tsx packages/db/scripts/verify-fuse.ts",
    "db:verify:connect": "tsx packages/db/scripts/verify-connect.ts",
    "db:verify:season": "tsx packages/db/scripts/verify-season.ts",
    "db:verify:season-console": "tsx packages/db/scripts/verify-season-console.ts",
    "db:verify:comms": "tsx packages/db/scripts/verify-comms.ts",
    "db:verify:stripe": "tsx packages/db/scripts/verify-stripe.ts",
    "db:verify:graduation": "tsx packages/db/scripts/verify-graduation.ts",
    "db:verify:voice": "tsx packages/db/scripts/verify-voice.ts",
    "db:verify:report": "tsx packages/db/scripts/verify-report.ts",
    "db:verify:delete": "tsx packages/db/scripts/verify-delete.ts",
    "db:verify:rate-limit": "tsx packages/db/scripts/verify-rate-limit.ts",
    "db:verify:photos": "tsx packages/db/scripts/verify-photos.ts",
    "db:verify:notifications": "tsx packages/db/scripts/verify-notifications.ts",
    "db:verify:geography": "tsx packages/db/scripts/verify-geography.ts",
    "db:verify:verification": "tsx packages/db/scripts/verify-verification.ts",
    "db:verify:admission-route": "tsx packages/db/scripts/verify-admission-route.ts",
    "db:verify:photo-screening": "tsx packages/db/scripts/verify-photo-screening.ts",
    "admin:grant": "tsx packages/db/scripts/grant-admin.ts",
    "vapid:keys": "node apps/web/scripts/vapid-keys.mjs"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "tsx": "^4.23.1",
    "turbo": "^2.6.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@next/env": "^16.3.4"
  }
}
