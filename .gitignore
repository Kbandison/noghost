# dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage/

# next.js
.next/
out/

# production
build/
dist/

# turbo
.turbo/

# supabase local
supabase/.branches
supabase/.temp
supabase/.env

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (.env.example is committed on purpose)
.env
.env*.local
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.env*

# Copied from node_modules by apps/web/scripts/vendor-liveness-assets.mjs on
# every build. Committing them invites exactly the version drift the script
# exists to prevent.
apps/web/public/tfjs-wasm/
