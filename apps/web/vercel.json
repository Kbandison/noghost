{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/claim-sweep",
      "schedule": "7 * * * *"
    },
    {
      "path": "/api/cron/fuse-sweep",
      "schedule": "17 * * * *"
    },
    {
      "path": "/api/cron/checkin-sweep",
      "schedule": "27 * * * *"
    },
    {
      "path": "/api/cron/connect-sweep",
      "schedule": "37 * * * *"
    },
    {
      "path": "/api/cron/generate-drops",
      "schedule": "30 23 * * *"
    },
    {
      "path": "/api/cron/release-drops",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/release-drops",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/cron/notification-sweep",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/season-tick",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/cron/season-tick",
      "schedule": "0 11 * * *"
    }
  ]
}
