{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/claim-sweep",
      "schedule": "7 * * * *"
    },
    {
      "path": "/api/cron/fuse-sweep",
      "schedule": "17 * * * *"
    },
    {
      "path": "/api/cron/generate-drops",
      "schedule": "30 23 * * *"
    },
    {
      "path": "/api/cron/release-drops",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/release-drops",
      "schedule": "0 1 * * *"
    }
  ]
}
